# Environment Configuration Example
# Copy this file to .env.local and update values as needed

# API Configuration
VITE_API_URL=http://localhost:3001
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false

# External Services
VITE_ENERGY_DASHBOARD_URL=https://dashboard.motechenergyembedded.com/

# Shared accounts database (Supabase). See SETUP-SHARED-ACCOUNTS.md.
# The anon key is public by design; never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public). Leave empty if Supabase CAPTCHA protection is OFF.
VITE_TURNSTILE_SITE_KEY=
